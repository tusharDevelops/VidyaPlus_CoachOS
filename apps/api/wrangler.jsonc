{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vidyapluscos",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKER": "true"
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
